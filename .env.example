# Copy to .env and fill in. Nothing here is required for local development.

# Store-facing identifiers (defaults come from src/config/brand.json)
APP_DISPLAY_NAME=
EXPO_SLUG=
IOS_BUNDLE_IDENTIFIER=
ANDROID_PACKAGE=

# Crisis support shown when a reading question mentions self-harm. Only fill these in with a
# service you have verified for your audience (name + phone and/or website). Leave blank to show
# the general message without a number.
CRISIS_HELPLINE_NAME=
CRISIS_HELPLINE_PHONE=
CRISIS_HELPLINE_URL=

# Legal pages (Settings → Privacy Policy / Terms of Use / About). The publisher is the person or
# company responsible for the app in the stores; the email is where users can reach you.
# LEGAL_EFFECTIVE_DATE uses YYYY-MM-DD. Sections that need a blank value are hidden.
PUBLISHER_NAME=
SUPPORT_EMAIL=
LEGAL_EFFECTIVE_DATE=

# Optional cloud backup of the journal (Supabase). Leave ENABLE_CLOUD_SYNC empty to ship a fully
# offline app. To turn it on, create a Supabase project, apply supabase/migrations, deploy
# supabase/functions/delete-account, enable the Email (OTP code) sign-in provider, then fill in:
ENABLE_CLOUD_SYNC=
SUPABASE_URL=
# The public "anon" key (safe to ship in the app; row-level security protects the data).
SUPABASE_ANON_KEY=
# How people sign in: comma-separated providers (google, apple). Default: google. On iOS, Google
# is only offered together with apple (App Store rule 4.8), so iOS has no backup until you add it.
SYNC_PROVIDERS=google
# Set to true to also show the email one-time-code form (needs working email sending in Supabase).
SYNC_EMAIL=

# Optional Premium (RevenueCat). Use the public SDK keys from RevenueCat → Project → API keys.
# Without a key for a platform there is no paywall there and every feature is unlocked.
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=
# Entitlement identifier that unlocks Premium (create it in RevenueCat and attach your products).
REVENUECAT_ENTITLEMENT=premium

# Optional local payment partner for people without a card (e.g. a shop that sells Premium
# promo/offer codes via KBZPay or WavePay). Both must be set to show the section. Check the
# App Store and Google Play payment rules for your region before enabling this.
LOCAL_PAYMENT_URL=
LOCAL_PAYMENT_NAME=

# Optional ads (Google AdMob). Off unless ENABLE_ADS=true. Create the app and ad units (Banner and
# Rewarded, per platform) in AdMob. Development builds always show Google's test ads. Without the
# app IDs, release builds use Google's sample IDs, which earn nothing. Premium hides all ads.
# Before turning this on, read docs/MONETIZATION.md (privacy policy, store forms, consent).
ENABLE_ADS=
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
ADMOB_BANNER_ANDROID=
ADMOB_BANNER_IOS=
ADMOB_REWARDED_ANDROID=
# Optional: comma-separated AdMob test device IDs (find yours in logcat: "Use RequestConfiguration...")
ADMOB_TEST_DEVICES=
ADMOB_REWARDED_IOS=
