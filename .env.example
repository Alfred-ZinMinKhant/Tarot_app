# Copy to .env and fill in. Nothing here is required for local development.

# Store-facing identifiers (defaults come from src/config/brand.json)
APP_DISPLAY_NAME=
EXPO_SLUG=
IOS_BUNDLE_IDENTIFIER=
ANDROID_PACKAGE=

# Crisis support shown when a reading question mentions self-harm. Only fill these in with a
# service you have verified for your audience (name + phone and/or website). Leave blank to show
# the general message without a number.
CRISIS_HELPLINE_NAME=
CRISIS_HELPLINE_PHONE=
CRISIS_HELPLINE_URL=
