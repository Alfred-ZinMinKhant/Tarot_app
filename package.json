{
  "name": "nattarot",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "2.116.0",
    "expo": "~57.0.29",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.27",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "10.9.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "sql.js": "^1.15.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "playwright": "1.63.0",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings 0",
    "test": "jest",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "validate": "npm run check:i18n && npm run check:cards && npm run check:content",
    "ci": "npm run typecheck && npm run lint && npm run validate && npm test -- --ci",
    "i18n:mark-pending": "tsx scripts/check-i18n.ts --mark-pending",
    "build:cards": "tsx scripts/build-cards.ts",
    "check:cards": "tsx scripts/validate-cards.ts",
    "render:card-back": "tsx scripts/render-card-back.ts",
    "images": "tsx scripts/optimize-images.ts",
    "check:content": "tsx scripts/validate-content.ts",
    "render:sounds": "tsx scripts/render-sounds.ts",
    "render:icons": "tsx scripts/render-icons.ts",
    "store:screenshots": "tsx scripts/store-screenshots.ts",
    "legal:export": "tsx scripts/export-legal.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.maestro/"
    ],
    "resolver": "react-native-worklets/jest/resolver.js"
  }
}
